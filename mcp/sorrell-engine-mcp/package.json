  "description": "MCP server & NPX runner for Sorrell Engine — browser-native neural operating system and tiny model swarm (WebMCP).",
  "type": "module",
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "test": "node --test test/*.test.mjs",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "bin": {
    "sorrell-engine-mcp": "./build/index.js",
    "sorrell-engine": "./build/index.js"
  },
  "files": [

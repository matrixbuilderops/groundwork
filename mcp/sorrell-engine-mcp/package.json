  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}

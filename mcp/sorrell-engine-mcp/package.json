    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "webmcp",
    "tiny-models",
    "model-swarm",
    "browser-native",
    "ai-agent",
    "code-generation"
  ],
